:: ============================================================
:: User config — edit this file, not run.bat
:: Leave a value blank ("") to fall back to XFL_DEFAULT
:: ============================================================

:: Input folder (folder containing LIBRARY or Symbol XMLs)
set "XFL_ROOT=C:\Users\Admin\xfl2svg\xfl"

:: Remove background rect: y / n
set "NO_BG_IN=y"

:: Center content in viewport: y / n
set "CENTER_IN=y"

:: Remove outer frame: y=always remove, n=always keep, ""=auto (smart)
set "FRAME_IN="

:: Stage size override — leave "" to use stage default (550x400)
set "WIDTH="
set "HEIGHT="

:: Symbol to render — leave "" to render all
set "SYMBOL="
